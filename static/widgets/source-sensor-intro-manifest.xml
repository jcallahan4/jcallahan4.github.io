  <HighResolutionIconUrl DefaultValue="https://www.jake-callahan.com/widgets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.jake-callahan.com"/>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://www.jake-callahan.com/widgets/source-sensor-intro.html"/>
