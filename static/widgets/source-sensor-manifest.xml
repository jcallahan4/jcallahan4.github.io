  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://www.jake-callahan.com/widgets/source-sensor.html"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>400</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
</OfficeApp>
